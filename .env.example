# Postgres
POSTGRES_PASSWORD=changeme
# Full connection string for local dev / drizzle-kit
DATABASE_URL=postgres://winerr:changeme@localhost:5432/winerr
# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# AI provider (Phase 2B). Leave GEMINI_API_KEY blank to disable AI features
# (manual entry + name search still work; drink windows show "—").
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
