# Postgres
POSTGRES_PASSWORD=changeme
# Full connection string for local dev / drizzle-kit
DATABASE_URL=postgres://winerr:changeme@localhost:5432/winerr
# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# AI provider: "mistral" (free, EU-friendly) or "gemini". Set the matching key
# below. (If unset, the code falls back to "gemini".)
# In the EU, Gemini's FREE tier is unavailable (ToS) — use Mistral (free, EU).
# Leave the active provider's key blank to disable AI features entirely
# (manual entry + name search still work; drink windows show "—").
AI_PROVIDER=mistral
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_API_KEY=
# MISTRAL_MODEL defaults to pixtral-12b-latest (free-tier vision); override if needed
MISTRAL_MODEL=
