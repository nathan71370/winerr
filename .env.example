# Postgres
POSTGRES_PASSWORD=changeme
# Full connection string for local dev / drizzle-kit
DATABASE_URL=postgres://winerr:changeme@localhost:5432/winerr
# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_TRUST_HOST=true
# AI provider + API keys are now configured per-account in /settings
# (encrypted at rest) — not via instance env vars. AI_PROVIDER, GEMINI_API_KEY,
# GEMINI_MODEL, MISTRAL_API_KEY and TAVILY_API_KEY no longer do anything here.
# MISTRAL_MODEL stays an optional override of the internal default
# (pixtral-12b-latest) if you need to pin a different model instance-wide.
MISTRAL_MODEL=

# Price tracking: quotes are re-estimated when older than this many days (default 30).
# This is a global instance policy; whether quotes run at all depends on each
# user's own Tavily + Mistral keys configured in /settings.
PRICE_REFRESH_DAYS=30

# Registration whitelist: comma-separated emails allowed to register.
# Unset or empty = open registration.
REGISTER_EMAIL_WHITELIST=
